  "teignbridgeroads": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "green",
        "width": 1
      }
    },
    "themes": [
      {
        "condition": {
          "equal": {
            "name": "class",
            "value": "Motorway"
          }
        },
        "style": {
          "stroke": {
            "color": "blue",
            "width": 6
          }
        },
        "name": "Motorway"
      },
      {
        "condition": {
          "equal": {
            "name": "class",
            "value": "A Road"
          }
        },
        "style": {
          "stroke": {
            "color": "red",
            "width": 4
          }
        },
        "name": "A Roads"
      },
      {
        "condition": {
          "equal": {
            "name": "class",
            "value": "B Road"
          }
        },
        "style": {
          "stroke": {
            "color": "orange",
            "width": 3
          }
        },
        "name": "B Roads"
      },
      {
        "condition": {
          "equal": {
            "name": "road_function",
            "value": "Minor Road"
          }
        },
        "style": {
          "stroke": {
            "color": "RGBA(255,0,255,1)",
            "width": 1
          }
        },
        "name": "Minor Roads"
      },
      {
        "condition": {
          "isnull": {
            "name": "count_point_id"
          }
        },
        "style": {
          "stroke": {
            "color": "black",
            "width": 6
          }
        },
        "name": "No count_point_id"
      }
    ],
    "layer": null,
    "name": "Teignbridge Roads",
    "summary": [ ".roadnumber", ".name1", " : ", "+layername" ],
    "url":"/mapdata/roads/teignbridgeroads.json"
  },
