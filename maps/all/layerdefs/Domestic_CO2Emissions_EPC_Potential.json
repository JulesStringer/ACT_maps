{
  "TeignbridgeParishes": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "rgba(255,0,0,0.5)",
        "width": 1
      },
      "fill": { "color": "rgba(0,0,0,0)" }
    },
    "layer": null,
    "name": "Teignbridge Parishes",
    "summary": [ ".code", ".name", " : Current:", ".EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_CURRENT", " Potential:", ".EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL", " tonnes CO<sub>2</sub> EPC year ", "+layername" ],
    "on": true,
    "clickable": true,
    "ZIndex": 2,
    "showselected": false,
    "url":"/mapdata/boundaries/TeignbridgeParishes.json"
  },
  "TeignbridgeOutputAreas": {
