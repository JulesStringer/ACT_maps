    "style": {
      "stroke": null,
      "fill": {
        "color": "rgba(0,0,0,0)"
      }
    },
    "themes": [
      {
        "condition": {
          "less": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "value": 1
          }
        },
        "style": {
          "fill": {
            "color": "rgba(0,0,0,0)"
          }
        },
        "name": "Under 1 tonnes CO<sub>2</sub> per EPC year"
      },
      {
        "condition": {
          "between": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "min": 1,
            "max": 2
          }
        },
        "style": {
          "fill": {
            "color": "rgba(0,255,0,0.5)"
          }
        },
        "name": "1 to 2 tonnes CO<sub>2</sub> per EPC year"
      },
      {
        "condition": {
          "between": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "min": 2,
            "max": 3
          }
        },
        "style": {
          "fill": {
            "color": "rgba(255,255,0,0.5)"
          }
        },
        "name": "2 to 3 tonnes CO<sub>2</sub> per EPC year"
      },
      {
        "condition": {
          "between": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "min": 3,
            "max": 4
          }
        },
        "style": {
          "fill": {
            "color": "rgba(255,192,0,0.5)"
          }
        },
        "name": "3 to 4 tonnes CO<sub>2</sub> per EPC year"
      },
      {
        "condition": {
          "between": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "min": 4,
            "max": 5
          }
        },
        "style": {
          "fill": {
            "color": "rgba(255,128,0,0.5)"
          }
        },
        "name": "4 to 5 tonnes CO<sub>2</sub> per EPC year"
      },
      {
        "condition": {
          "greaterequal": {
            "name": "EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL",
            "value": 5
          }
        },
        "style": {
          "fill": {
            "color": "rgba(255,0,0,0.5)"
          }
        },
        "name": "5 tonnes CO<sub>2</sub> and over per EPC year"
      }
    ],
    "layer": null,
    "name": "Teignbridge Census Output Areas",
    "summary": [ ".oa11cd", " : Current:", ".EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_CURRENT", " Potential:", ".EPC_DERIVED.DOMESTIC_EMISSIONS_PER_EPC_POTENTIAL", " tonnes CO<sub>2</sub> EPC year ", "+layername" ],
    "on": true,
    "clickable": true,
    "minZoom": 5,
    "ZIndex": 1,
    "showselected": true,
    "url":"/mapdata/census/TeignbridgeOutputAreas.json"
  }
