{
  "WOODLAND": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "black",
        "width": 1
      },
      "fill": {
        "color": "rgba(0,255,128,0.4)"
      }
    },
    "url": "/mapdata/naturalenvironment/WOODLAND.json",
    "layer": null,
    "name": "Woodland",
    "summary": [ "+layername" ],
    "minZoom": 12,
    "tooltip": "Woodland layer from Ordnance Survey Vector Map Local should have all woodland."
  },
  "AgriculturalLandClassification": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "green",
        "width": 1
      },
      "fill": { "color": "rgba(0,0,0,0)" }
    },
    "themes": [
      {
        "condition": {
          "greater": {
            "name": "alc_grade",
            "value": "Grade 1"
          }
        },
        "style": {
          "stroke": {
            "color": "rgba(255,255,0,1)",
            "width": 1
          },
          "fill": {
            "color": "rgba(255,255,0,0.4)"
          }
        },
        "name": "Grade 1"
      },
      {
        "condition": {
          "greater": {
            "name": "alc_grade",
            "value": "Grade 2"
          }
        },
        "style": {
          "stroke": {
            "color": "rgba(192,192,0,1)",
            "width": 1
          },
          "fill": {
            "color": "rgba(192,192,0,0.4)"
          }
        },
        "name": "Grade 2"
      },
      {
        "condition": {
          "greater": {
            "name": "alc_grade",
            "value": "Grade 3"
          }
        },
        "style": {
          "stroke": {
            "color": "rgba(128,128,0,1)",
            "width": 1
          },
          "fill": {
            "color": "rgba(128,128,0,0.4)"
          }
        },
        "name": "Grade 3"
      },
      {
        "condition": {
          "greater": {
            "name": "alc_grade",
            "value": "Grade 4"
          }
        },
        "style": {
          "stroke": {
            "color": "rgba(64,64,0,1)",
            "width": 1
          },
          "fill": {
            "color": "rgba(64,64,0,0.1)"
          }
        },
        "name": "Grade 4"
      },
      {
        "condition": {
          "greater": {
            "name": "alc_grade",
            "value": "Grade 5"
          }
        },
        "style": {
          "stroke": {
            "color": "rgba(32,32,0,1)",
            "width": 1
          },
          "fill": {
            "color": "rgba(32,32,0,0.1)"
          }
        },
        "name": "Grade 5"
      }
    ],
    "layer":null,
    "url":"/mapdata/naturalenvironment/Agricultural_Land_Classification.json",
    "name":"Agricultural Land Classification",
    "summary":[ "+layername" ],
    "tooltip":"Agricultural land classification layer"
  },
