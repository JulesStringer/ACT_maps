{
  "Teignbridge": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "red",
        "width": 4
      },
      "fill": {
        "color": "rgba(0,0,0,0)"
      }
    },
    "themes": [
      {
        "condition": {
          "notnull": { "name": "declared" }
        },
        "style": {
          "fill": {
            "color": "rgba(0,255,0,0.08)"
          },
          "name": "Climate Emergency Declared"
        }
      }
    ],
    "layer": null,
    "name": "Teignbridge District",
    "summary": [ ".code", ".name" ],
    "links": [
      {
        "url": [ "/mapping/TeignbridgeDUKES_GHG.html" ],
        "text": "Teignbridge Energy and Emissions Statistics"
      }
    ],
    "url":"/mapdata/boundaries/Teignbridge.json"
  },
  "TeignbridgeParishes": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "red",
        "width": 2
      },
      "fill": { "color": "rgba(0,0,0,0)" }
    },
    "themes": [
      {
        "condition": {
          "notnull": { "name": "declared" }
        },
        "style": {
          "fill": {
            "color": "rgba(0,255,0,0.12)"
          }
        },
        "name": "Climate Emergency Declared"
      }
    ],
    "layer": null,
    "name": "Teignbridge Parishes",
    "summary": [ ".code", ".name", " : ", "+layername" ],
    "url":"/mapdata/boundaries/TeignbridgeParishes.json"
  },
  "TeignbridgeWards": {
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "green",
        "width": 2
      },
      "fill": { "color": "rgba(0,0,0,0)" }
    },
    "layer": null,
    "name": "Teignbridge Wards",
    "summary": [".WD19NM", " : ","+layername" ],
    "url":"/mapdata/boundaries/TeignbridgeWards.json"
  },
  "teignbridgeroads":{
    "type": "geoJSON",
    "style": {
      "stroke": {
        "color": "red",
        "width": 2
      }
    },
    "layer": null,
    "name": "Teignbridge Roads",
    "summary": [ ".roadnumber", ".name1", " : ","+layername" ],
    "url":"/mapdata/roads/teignbridgeroads.json"
  },
  "TrafficCounters":{
    "type": "geoJSON",
    "style": { 
        "image": {
           "type": "shape",
           "points": 8,
           "radius1": 10,
           "radius2": 3,
           "radius": 5,
           "fill" : {"color": "rgba(255,0,0,0.2)"},
           "stroke": {"color": "black","width":1} 
        }
    },
    "layer": null,
    "name": "Traffic Counters",
    "summary": [ ".road_name"," : ","+layername" ],
    "url":"/mapdata/roads/TrafficCounters.json"
  },
